shader_type canvas_item;
render_mode blend_disabled, unshaded;
// Бытовая видеокамера 1990 года (VHS-C / Hi8) — то, что происходит ДО записи на плёнку.
// Считается в разрешении кадра (480/600/720 строк). Источник src — кадр 3D-мира после инерции матрицы (cam_lag),
// значения уже после тонмаппинга (0..1), поэтому свет считается в приближённо линейном виде (гамма 2.2).
//
//   1. ОБЪЕКТИВ: лёгкая бочка с заполнением кадра (углы кадра = углы источника, чёрных краёв нет),
//      поперечная хроматическая аберрация, растущая к углам, мягкость краёв, естественная виньетка
//      по настоящему радиусу (с учётом формата 4:3 / 16:9), «поиск» автофокуса (defocus).
//   2. МАТРИЦА: «настоящая» яркость выбитых в белое источников (лампы, солнце — cam_common hot_of/sun_hot;
//      светлая дымка неба, белый газ и белые вещи источниками не считаются), ирис (exposure) и автоусиление (agc),
//      ореол (halation) из яркого Glow1..Glow4 (в основном тесный — повторяет форму светильника, широкая дымка
//      слабая; усиление его почти не раздувает), вертикальный смаз ПЗС (от солнца в кадре — всегда, от прочих
//      выбитых источников — при сильном усилении, мягкий по краям), баланс белого, мягкое колено и честный
//      клип в чистый белый с выцветанием светов, шум матрицы при усилении.
//   3. РАНЕНИЕ: «сбой камеры» — цветовой тракт отказывает с краёв кадра (красное наползает неровно и нелинейно,
//      яркость остаётся, лампы — белые, а не розовые), ирис/усиление «качает» в такт сердцу; при смерти весь кадр
//      красный со следом последнего кадра (still_tex).
//   4. OSD: впечатанные в запись дата и время из прозрачного вьюпорта — поверх картинки и ПОСЛЕ ранения
//      (генератор символов — отдельная электроника, буквы остаются белыми); дальше всё вместе уходит на плёнку
//      (vhs.gdshader). REC, батарея, SP — только в видоискателе: их рисует osd.gd отдельным слоем после плёнки.

uniform sampler2D src : filter_linear, repeat_disable;
uniform sampler2D glow_a : filter_linear, repeat_disable;     // яркое, 1/4 кадра
uniform sampler2D glow_b : filter_linear, repeat_disable;     // яркое, размыто, 1/8 кадра
uniform sampler2D glow_c : filter_linear, repeat_disable;     // яркое, широко размыто, 1/16 кадра
uniform sampler2D glow_d : filter_linear, repeat_disable;     // яркое, очень широко, 1/32 кадра (дымка)
uniform sampler2D osd_tex : filter_nearest, repeat_disable;   // надписи камеры (прозрачный фон)
uniform vec2 src_size = vec2(640.0, 480.0);
uniform vec2 glow_a_size = vec2(160.0, 120.0);
uniform vec2 glow_b_size = vec2(80.0, 60.0);
uniform vec2 glow_c_size = vec2(40.0, 30.0);
uniform vec2 glow_d_size = vec2(20.0, 15.0);

// --- объектив ---
uniform float distort = 0.03;       // бочка (k1, в высотах кадра): у бытового зума на широком конце — едва-едва
uniform float ca = 0.0045;          // поперечная ХА: разница масштаба R/B на краю
uniform float edge_soft = 0.9;      // мягкость в углах, пикс
uniform float vignette = 0.26;      // падение света к краям: 1/(1+v·r²)²
uniform float defocus = 0.0;        // поиск автофокуса 0..1
// --- матрица ---
uniform float exposure = 1.0;       // ирис: линейный множитель света (1 — норма, 0.5 — на ступень темнее)
uniform float agc = 1.0;            // автоусиление: множитель яркости картинки, как прежний gain (1..2.4+)
uniform float hot_boost = 3.0;      // во сколько раз выбитые в 1.0 лампы «на самом деле» ярче
uniform float halation = 1.0;       // сила ореола
uniform float smear = 1.0;          // сила вертикального смаза ПЗС
uniform vec3 sun = vec3(0.0);       // солнце: xy — в кадре (от центра, в высотах кадра, после бочки), z — 0..1 (нет / в кадре)
uniform vec3 white_bal = vec3(1.035, 1.0, 0.87);   // баланс белого (линейный): тёпло-нейтральный (задаёт main.gd)
uniform vec3 halo_tint = vec3(1.0, 0.84, 0.6);     // тёплый ореол
// --- ранение ---
uniform float hurt = 0.0;           // 0..1: кадр краснеет от краёв к центру (полоски здоровья нет)
uniform float hurt_flash = 0.0;     // вспышка в момент удара
uniform sampler2D still_tex : filter_linear, repeat_disable;   // последний кадр перед смертью (main.gd)
uniform float still_amt = 0.0;      // сколько его осталось в красном кадре смерти

const vec3 LUMA = vec3(0.299, 0.587, 0.114);

#include "res://src/shaders/cam_common.gdshaderinc"

float max3(vec3 c) {
	return max(c.r, max(c.g, c.b));
}

// целочисленный хеш (PCG) — шум матрицы
uint pcg(uint v) {
	uint s = v * 747796405u + 2891336453u;
	uint w = ((s >> ((s >> 28u) + 4u)) ^ s) * 277803737u;
	return (w >> 22u) ^ w;
}

float h3(vec3 p) {
	uvec3 q = uvec3(ivec3(floor(p)) + ivec3(65536));
	return float(pcg(q.x + pcg(q.y + pcg(q.z)))) * (1.0 / 4294967295.0);
}

float noise1(float x, float seed) {
	float i = floor(x);
	float f = fract(x);
	return mix(h3(vec3(i, seed, 0.0)), h3(vec3(i + 1.0, seed, 0.0)), f * f * (3.0 - 2.0 * f));
}

// кубический B-сплайн через 4 билинейные выборки: гладкий ореол из маленькой текстуры, без «ромбиков»
vec4 cubic_w(float v) {
	vec4 n = vec4(1.0, 2.0, 3.0, 4.0) - v;
	vec4 s = n * n * n;
	float x = s.x;
	float y = s.y - 4.0 * s.x;
	float z = s.z - 4.0 * s.y + 6.0 * s.x;
	float w = 6.0 - x - y - z;
	return vec4(x, y, z, w) * (1.0 / 6.0);
}

vec3 tex_bicubic(sampler2D t, vec2 uv, vec2 size) {
	vec2 tc = uv * size - 0.5;
	vec2 f = fract(tc);
	tc -= f;
	vec4 xc = cubic_w(f.x);
	vec4 yc = cubic_w(f.y);
	vec4 c = tc.xxyy + vec2(-0.5, 1.5).xyxy;
	vec4 s = vec4(xc.xz + xc.yw, yc.xz + yc.yw);
	vec4 o = (c + vec4(xc.yw, yc.yw) / s) / size.xxyy;
	vec3 s0 = texture(t, o.xz).rgb;
	vec3 s1 = texture(t, o.yz).rgb;
	vec3 s2 = texture(t, o.xw).rgb;
	vec3 s3 = texture(t, o.yw).rgb;
	float sx = s.x / (s.x + s.y);
	float sy = s.z / (s.z + s.w);
	return mix(mix(s3, s2, sx), mix(s1, s0, sx), sy);
}

// мягкое колено и честный клип: до K — как есть, выше плавно (наклон 1 → 0) до 1.0, дальше — чистый белый
vec3 soft_clip(vec3 x) {
	const float K = 0.86;
	vec3 t = clamp(x - K, 0.0, 2.0 * (1.0 - K));
	vec3 k = K + t - t * t / (4.0 * (1.0 - K));
	return mix(x, k, step(K, x));
}

void fragment() {
	// ================= 1. ОБЪЕКТИВ =================
	float aspect = src_size.x / src_size.y;
	vec2 to_uv = vec2(1.0 / aspect, 1.0);
	vec2 p = (UV - 0.5) * vec2(aspect, 1.0);          // в высотах кадра от центра
	float r2 = dot(p, p);
	float rc2 = (aspect * aspect + 1.0) * 0.25;        // радиус² угла кадра
	vec2 q = p * (1.0 + distort * r2) / (1.0 + distort * rc2);
	vec2 suv = q * to_uv + 0.5;
	// поперечная ХА: красный чуть крупнее, синий мельче — цветная кайма растёт к углам
	float cr = ca * r2 / rc2;
	vec3 s = vec3(texture(src, q * (1.0 + cr) * to_uv + 0.5).r,
				texture(src, suv).g,
				texture(src, q * (1.0 - cr) * to_uv + 0.5).b);
	// мягкость к краям (дешёвая оптика) и поиск автофокуса
	float rad = edge_soft * (r2 / rc2) + defocus * 2.6;
	if (rad > 0.08) {
		vec2 d = rad / src_size;
		vec3 b = texture(src, suv + vec2(0.7071, 0.7071) * d).rgb;
		b += texture(src, suv + vec2(-0.7071, 0.7071) * d).rgb;
		b += texture(src, suv + vec2(0.7071, -0.7071) * d).rgb;
		b += texture(src, suv + vec2(-0.7071, -0.7071) * d).rgb;
		float n = 4.0;
		if (defocus > 0.02) {
			b += texture(src, suv + vec2(1.0, 0.0) * d).rgb;
			b += texture(src, suv + vec2(-1.0, 0.0) * d).rgb;
			b += texture(src, suv + vec2(0.0, 1.0) * d).rgb;
			b += texture(src, suv + vec2(0.0, -1.0) * d).rgb;
			n = 8.0;
		}
		s = mix(s, b / n, clamp(rad * 0.6, 0.0, 0.85));
	}

	// ================= 2. МАТРИЦА =================
	// выбитое в 1.0 после тонмаппинга — на самом деле в разы ярче: так лампа остаётся белой и при прикрытом ирисе
	// «горячим» считается белое выбитое (лампы), а не просто насыщенно-яркое (голубое небо, жёлтая стена)
	// (диск солнца — тоже: по положению, cam_common sun_hot)
	float hot = max(hot_of(s), sun_hot(s, p, sun, 1.0));
	vec3 lin = pow(max(s, vec3(0.0)), vec3(2.2)) * (1.0 + hot * hot * hot_boost);
	float vig = 1.0 / ((1.0 + vignette * r2) * (1.0 + vignette * r2));
	lin *= exposure * vig;
	// автоусиление (AGC): прежний смысл gain — множитель яркости картинки; усиливается сигнал над уровнем
	// чёрного: самое тёмное почти не поднимается (темнота остаётся тёмной, только шумит на плёнке),
	// а то, что хоть немного освещено, в темноте становится заметно светлее
	float G = pow(max(agc, 0.01), 1.76);
	// усиление тянет тени и полутона, а уже яркое (лампа, потолок у лампы) почти не трогает — иначе в тёмной
	// комнате одна лампа раздувается в огромный белый «солнечный» диск
	float yl = dot(lin, LUMA);
	float gk = G / (1.0 + yl * (G - 1.0) * 1.1);
	lin *= mix(1.0, max(gk, 1.0), smoothstep(0.0, 0.04, yl));
	float ex = exposure * G;
	// ореол: тесный венчик (Glow1) + ореол (Glow2) + широкая тёплая дымка (Glow3, Glow4).
	// Glow хранят «энергию» (выбитая лампа ≈ 4): основная доля — в тесных Glow1/Glow2, поэтому ореол повторяет
	// форму светильника (прямоугольник «расплывается» по плиткам потолка), а не превращается в круглый диск;
	// широкая дымка слабая. Небо, белый газ и белые вещи на солнце почти не светятся (cam_glow bright).
	// Усиление (AGC) поднимает ореол лишь чуть-чуть: в тёмной комнате лампа не раздувается в «солнце» —
	// выбитая сердцевина остаётся прямоугольной, а ореол мягко гаснет (колено halo/(1+…) не даёт ему
	// самому выбиться в белое пятно на полкадра).
	vec3 ga = tex_bicubic(glow_a, suv, glow_a_size);
	vec3 gb = tex_bicubic(glow_b, suv, glow_b_size);
	vec3 gc = tex_bicubic(glow_c, suv, glow_c_size);
	vec3 gd = tex_bicubic(glow_d, suv, glow_d_size);
	vec3 halo = (ga * 0.4 + gb * 0.52 + gc * 0.3 + gd * 0.08) * halation;
	halo *= exposure * pow(G, 0.3);
	halo /= 1.0 + 0.25 * max3(halo);
	lin += halo * halo_tint;
	// вертикальный смаз ПЗС (заряд стекает по столбцу при переносе):
	// а) солнце в кадре — тонкая светлая полоса во весь столбец через диск (ширина — с настоящий диск солнца,
	//    а не с ореол вокруг него) при любой экспозиции; гаснет, когда солнце закрыто (ветки, облако)
	if (sun.z > 0.001) {
		vec2 qs = sun.xy * (1.0 + distort * dot(sun.xy, sun.xy)) / (1.0 + distort * rc2);
		float vis = smoothstep(2.2, 3.7, max3(texture(glow_a, qs * to_uv + 0.5).rgb));
		float rk = src_size.y / 480.0;
		float dx = (p.x - sun.x) * src_size.y / rk;          // в пикселях кадра 480 строк
		float w = exp(-dx * dx / 9.0) + 0.3 * exp(-dx * dx / 150.0);
		float near = exp(-abs(p.y - sun.y) * 4.0);
		lin += vec3(0.97, 0.98, 1.0) * w * vis * (0.3 + 0.35 * near) * smear * sun.z;
	}
	// б) прочие яркие места — только когда матрица сильно переэкспонирована (усиление в темноте) и только
	//    от настоящих выбитых источников (лампа, фара): классическая «ночная» картинка бытовой камеры.
	//    Столбец набирается из Glow2 (1/8 кадра, гауссово размыт) по 30 строкам; порог плавный — края полосы
	//    мягкие, как у самого источника, без ступеньки. Светлые протяжённые места (край Земли, небо) не
	//    «горячие» (cam_glow bright) — от них полосы нет.
	float over = max(ex - 1.4, 0.0);
	if (over > 0.0) {
		float sm = 0.0;
		for (int i = 0; i < 30; i++) {
			float g = max3(texture(glow_b, vec2(suv.x, (float(i) + 0.5) / 30.0)).rgb);
			sm += g * smoothstep(0.9, 2.2, g);
		}
		lin += vec3(0.96, 0.97, 1.0) * sm * 0.0006 * smear * min(over, 1.6);
	}
	// баланс белого
	lin *= white_bal;
	// кодирование камеры: гамма, выцветание светов (соседние каналы догоняют выбитый), колено и клип
	vec3 v = pow(lin, vec3(1.0 / 2.2));
	v += max(max3(v) - 0.9, 0.0) * 0.55;
	v = clamp(soft_clip(v), 0.0, 1.0);
	// шум матрицы при усилении (до плёнки): мелкий, по пикселю, сильнее в тенях
	float fr = mod(floor(TIME * 59.94), 7200.0);
	vec2 px = floor(UV * src_size);
	float gn = clamp(agc - 1.0, 0.0, 2.5);
	if (gn > 0.001) {
		float dk = 1.0 - smoothstep(0.1, 0.7, dot(v, LUMA));
		float nz = (h3(vec3(px, fr * 3.0 + 1.0)) + h3(vec3(px, fr * 3.0 + 2.0)) - 1.0) * 0.016 * gn * (0.5 + dk);
		v = max(v + nz, 0.0);
	}

	// ================= 3. РАНЕНИЕ =================
	// не плоский красный фильтр, а отказ камеры: с краёв (неровной, «ползущей» границей) цветовой тракт
	// сходит с ума — яркость остаётся, цвет уходит в красный; на ударах сердца автоусиление «качает».
	// При hurt = 1 (смерть) кадр красный целиком — и красный экран смерти (end_red) тоже красит здесь;
	// в красном держится след последнего кадра (still_tex), поле неровное, плёнка шумит (vhs.gdshader).
	if (hurt > 0.001 || hurt_flash > 0.001) {
		float hr = clamp(hurt, 0.0, 1.0);
		float dead = smoothstep(0.97, 1.0, hr);
		float beat = pow(max(sin(TIME * (5.0 + hr * 3.0)), 0.0), 6.0) * hr * (1.0 - dead);
		vec2 vc = UV - 0.5;
		float ang = atan(vc.y, vc.x);
		// граница наползания неровная и медленно «дышит» (не идеальный эллипс игрового интерфейса);
		// целые кратности угла — без шва слева
		float wob = sin(ang * 2.0 + TIME * 0.35) * 0.07 + sin(ang * 3.0 - TIME * 0.27 + 1.7) * 0.06
			+ sin(ang * 5.0 + TIME * 0.6 + 4.1) * 0.035 + (noise1(TIME * 0.5, 31.0) - 0.5) * 0.06;
		// «расстояние до края»: скруглённый прямоугольник (0 — центр, 1 — края, углы чуть дальше) — красное
		// наползает со всех четырёх краёв одинаково, а не только из углов
		vec2 ve = abs(vc) * 2.0;
		float r = pow(pow(ve.x, 3.0) + pow(ve.y, 3.0), 1.0 / 3.0) + wob * 0.6 * (1.0 - hr * hr);
		// наползание нелинейное: при 0.3 — заметная красная кайма по краям, при 0.6 — красные края до
		// середины пути, а центр чистый; к 0.85 чистым остаётся только середина; целиком красный — смерть
		float front = 1.04 - 0.99 * pow(hr, 1.7) - beat * 0.08;
		float edge = smoothstep(front - 0.22, front + 0.1, r);
		float lr = dot(v, LUMA);
		// смерть: в красном остаётся след последнего кадра (матрица «выжжена» им) — медленно тает
		if (still_amt > 0.001) {
			float ls = dot(texture(still_tex, suv).rgb, LUMA);
			lr = clamp(mix(lr, lr * 0.4 + ls * 0.95, still_amt), 0.0, 1.0);
		}
		// цвет: красный канал несёт яркость, зелёный и синий проваливаются — тёмно-красный «кровавый»,
		// не неоновый; выбитый в белое источник (лампа: все каналы у клипа и «горячий» Glow1) остаётся почти
		// белым, лишь чуть тёплым — при отказе цвета яркость клипа никуда не девается (лампы не становятся
		// ярко-розовыми). Просто светлое и даже пересвеченное небо краснеет как всё. В кадре смерти — нет:
		// там всё поле одного красного.
		vec3 bled = vec3(0.04 + lr * 1.02, lr * 0.1 + lr * lr * 0.06, lr * 0.08 + lr * lr * 0.05);
		float clip = smoothstep(0.86, 0.98, min(v.r, min(v.g, v.b))) * smoothstep(0.4, 1.4, max3(ga));
		bled = mix(bled, vec3(lr) * vec3(1.0, 0.86, 0.82), clip * 0.8 * (1.0 - dead));
		float amt = clamp(edge * (0.75 + 0.25 * hr) + pow(hr, 4.0) * 0.25 + hurt_flash * 0.5 + dead, 0.0, 1.0);
		// в зоне сбоя цвет ещё и «плывёт»: строки чуть смещены по оттенку
		float lineflick = (h3(vec3(floor(UV.y * src_size.y * 0.5), fr, 33.0)) - 0.5) * 0.08 * edge * hr;
		v = mix(v, bled, clamp(amt + lineflick, 0.0, 1.0));
		// виньетка сжимается и «качается» с ударами сердца (ирис и усиление не справляются);
		// при смерти — неровное поле: светлее сверху, тёмные углы, медленное «дыхание» засвеченной матрицы
		v *= (1.0 - edge * 0.38 * hr * (1.0 - 0.6 * hr * hr * hr)) * (1.0 + beat * 0.14 * (1.0 - hr * 0.5));
		float breath = 1.0 + (noise1(TIME * 0.9, 41.0) - 0.5) * 0.12;
		v *= mix(1.0, (1.0 - 0.32 * r2 / rc2) * (1.06 - UV.y * 0.14) * breath, dead);
		v = clamp(v, 0.0, 1.0);
	}

	// ================= 4. OSD =================
	// прозрачный вьюпорт хранит цвет, уже умноженный на альфу (смешивание на пустой фон)
	vec4 o = texture(osd_tex, UV);
	v = v * (1.0 - o.a) + o.rgb;
	COLOR = vec4(v, 1.0);
}
