// Общее для шейдеров камеры (camera, cam_glow, cam_meter, cam_lag).

// «Горячее» место — настоящий источник света, выбитый тонмаппингом в белое (лампы, солнце, фары), а не просто
// светлое (дымка неба, белый газ, белая ткань на солнце). AgX сводит очень яркое к белому: чем ярче источник,
// тем ближе к 1.0 САМЫЙ ТЁМНЫЙ канал. Лампы Комплекса — min 0.957..0.988, насыщенность ≤ 0.016;
// дымка неба в парке — min ≈ 0.89 (синий отстаёт), насыщенность 0.04..0.07; белый газ Async — min ≤ 0.92.
float hot_of(vec3 c) {
	float mn = min(c.r, min(c.g, c.b));
	return smoothstep(0.925, 0.975, mn);
}

// Просто очень светлое (небо, белое на солнце) — для экспонометра: ирис прикрывается и на светлом небе,
// но ореола и «настоящей» яркости такие места не получают
float bright_of(vec3 c) {
	float mx = max(c.r, max(c.g, c.b));
	return smoothstep(0.9, 0.99, mx);
}

// Диск солнца (sp: xy — где оно в кадре в тех же координатах, что uv, z — 0..1 видно): AgX сводит солнце к тем же
// (1.0, 0.98, 0.93), что и дымку вокруг, поэтому «горячим» его делает положение — светлое в пределах диска
// (~0.016 высоты кадра). aspect — ширина/высота кадра (расстояние считается в высотах кадра).
float sun_hot(vec3 c, vec2 uv, vec3 sp, float aspect) {
	if (sp.z < 0.001) {
		return 0.0;
	}
	float d = length((uv - sp.xy) * vec2(aspect, 1.0));
	return sp.z * smoothstep(0.02, 0.008, d) * bright_of(c);
}
